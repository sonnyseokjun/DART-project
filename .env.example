# 이 파일을 .env 로 복사한 뒤 실제 값을 채우세요. .env 는 git에 커밋되지 않습니다.
# DART OpenAPI 인증키 (40자리 16진수). https://opendart.fss.or.kr 에서 발급.
# ⚠ 값을 비워 두면 서버는 정상적으로 뜨지만 공시 수집만 조용히 실패한다.
#   채운 뒤 RUNBOOK 2.7의 점검 명령으로 길이 40인지 확인할 것 (이슈 #42).
DART_API_KEY=
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=
OPENAI_API_KEY=

# --- 6단계 배포 ---
DJANGO_CSRF_TRUSTED_ORIGINS=
SITE_DOMAIN=
ADMIN_ALLOWED_IP=
S3_BACKUP_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-2

# --- 7단계 준실시간화 ---
# 화면 자동 갱신 간격(초). 감지가 1~3분이므로 이보다 짧게 할 이유는 없다.
# 줄을 지우거나 비워 두면 30이 쓰인다(config.settings._int_env).
REALTIME_POLL_INTERVAL_SECONDS=30

# --- 8단계 회원 (이슈 #44) ---
# 카카오 개발자 콘솔 → 앱 → 플랫폼 키 → REST API 키 / 클라이언트 시크릿(카카오 로그인)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 카카오 개발자 콘솔 → 앱 → 어드민 키. 탈퇴 시 연결 끊기·연결 해제 웹훅 확인에 쓴다
KAKAO_ADMIN_KEY=
# 개인정보처리방침에 적히는 보호책임자 연락처. 실제로 연락이 닿는 주소여야 한다
PRIVACY_CONTACT_EMAIL=