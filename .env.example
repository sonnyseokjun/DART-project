DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=
OPENAI_API_KEY=

# --- 6단계 배포 ---
DJANGO_CSRF_TRUSTED_ORIGINS=
SITE_DOMAIN=
ADMIN_ALLOWED_IP=
S3_BACKUP_BUCKET=
